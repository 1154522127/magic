{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magic-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "HISTORY",
      "id": "2191a490b13c4ebe830c896198fea8a7"
    }
  ],
  "triggers": {
    // 北京时间工作日 22:08 / 22:38 / 23:08 / 23:38（多一次重试，额度仍可忽略）
    "crons": ["8,38 14,15 * * 1-5"]
  }
}
